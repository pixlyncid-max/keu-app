# Konfigurasi environment untuk client React
# Salin file ini menjadi .env.local dan sesuaikan nilainya

# URL API Laravel backend (untuk production)
# Di development, Vite proxy sudah menangani /api -> localhost:8000
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Nama aplikasi (tampil di title bar)
VITE_APP_NAME="Keuangan Pribadi"

# Versi aplikasi
VITE_APP_VERSION=1.0.0
